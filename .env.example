# Copy to .env and replace every placeholder below with your own values.
# Never commit real credentials.

# PostgreSQL (required). Examples:
# - Local: postgresql://postgres:postgres@localhost:5432/marquee
# - Neon dev branch: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-string"

# Demo tenant seed (run manually: npm run db:seed)
FORCE_FED_ADMIN_EMAIL="admin@example.com"
FORCE_FED_ADMIN_PASSWORD="replace-with-a-strong-password"
NEON_HARBOR_DEMO_PASSWORD="replace-with-another-strong-password"

# Vercel Blob (optional locally; required on Vercel for admin uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Development only: return magic links in API responses (never enable in production)
# ALLOW_DEV_MAGIC_LINK="true"
