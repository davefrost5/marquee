{
  "name": "marquee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43123",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --port 43123",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^0.27.3",
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "next": "16.3.4",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.15.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
